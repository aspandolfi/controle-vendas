{
  "name": "controle-vendas",
  "version": "0.0.2",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "ng lint",
    "e2e": "cypress open",
    "e2e:headless": "cypress run",
    "e2e:docker": "cd .. && docker-compose --profile e2e-test run --rm web-e2e-test",
    "e2e:docker:build": "cd .. && docker-compose build web-e2e-test",
    "e2e:docker:up": "cd .. && docker-compose --profile dev up -d web-dev api dynamodb-local",
    "e2e:docker:down": "cd .. && docker-compose --profile dev down",
    "test:all": "npm test && npm run e2e:headless",
    "test:all:docker": "npm run e2e:docker"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "cypress": "^15.11.0",
    "jsdom": "^27.1.0",
    "less": "^4.2.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
