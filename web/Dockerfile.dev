# Development Dockerfile (Angular with hot reload)
FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci

# Copy source code
COPY . .

# Expose port
EXPOSE 4200

# Environment variables
ENV NODE_ENV=development

# Start development server
CMD ["npm", "start", "--", "--host", "0.0.0.0", "--port", "4200"]
